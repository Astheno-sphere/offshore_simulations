 "notes": [
  {
   "title": "Gion Shirakawa",
   "text": "Two-storey ochaya-style machiya from the late Edo to early Meiji period line the canal in the Gion Shinbashi preservation district, with Kyoto lattices facing the water.",
   "links": [
    {
     "label": "Kyoto City bridge leaflet (PDF)",
     "url": "https://www.city.kyoto.lg.jp/kensetu/cmsfiles/contents/0000149/149842/hashishirube03.pdf"
    },
    {
     "label": "Kyoto City Tourism",
     "url": "https://ja.kyoto.travel/event/single.php?event_id=4544"
    }
   ]
  },
  {
   "title": "Willows and cherries",
   "text": "About 43 cherry trees, of several kinds, and weeping willows line the Shirakawa. Their species come from these sources; the position of each tree here is illustrative.",
   "links": [
    {
     "label": "Jorudan",
     "url": "https://sp.jorudan.co.jp/hanami/spot_720.html"
    },
    {
     "label": "Kyoto City (PDF)",
     "url": "https://www.city.kyoto.lg.jp/kensetu/cmsfiles/contents/0000149/149842/hashishirube03.pdf"
    }
   ]
  },
  {
   "title": "Tatsumi-bashi",
   "text": "A steel girder bridge 7.5 m long and 3.1 m wide, finished in 1957, paved with stone and fenced with a wooden railing; the first bridge here was wooden, in 1829.",
   "links": [
    {
     "label": "Kyoto City (PDF)",
     "url": "https://www.city.kyoto.lg.jp/kensetu/cmsfiles/contents/0000149/149842/hashishirube03.pdf"
    }
   ]
  },
  {
   "title": "Tatsumi Daimyojin",
   "text": "A very small shrine on the triangular plot where two lanes fork: a torii, a small hokora, vermilion tamagaki carrying performers' names, and foxes on both sides. Its proportions here are read from photographs.",
   "links": [
    {
     "label": "4travel",
     "url": "https://4travel.jp/dm_shisetsu/11291565"
    }
   ]
  },
  {
   "title": "Kanikakuni stone",
   "text": "A natural Kurama stone about 30 m west of the bridge, carved with Yoshii Isamu's poem about the water flowing beneath his pillow. Its exact spot here is interpreted.",
   "links": [
    {
     "label": "Kyoto City (PDF)",
     "url": "https://www.city.kyoto.lg.jp/kensetu/cmsfiles/contents/0000149/149842/hashishirube03.pdf"
    }
   ]
  },
  {
   "title": "What is illustrative",
   "text": "Measured from OpenStreetMap: footprints, streets, the canal. Drawn by eye: heights (none are mapped here), each canal tree, the andon, people and traffic.",
   "links": [
    {
     "label": "OpenStreetMap",
     "url": "https://www.openstreetmap.org/#map=18/35.0057/135.7744"
    }
   ]
  }
 ],
